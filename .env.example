# Flask
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change-me-to-a-random-secret
PORT=5000

# JWT
JWT_SECRET_KEY=change-me-to-a-random-jwt-secret
JWT_ACCESS_TOKEN_EXPIRES_HOURS=24

# Database
# Local dev default: sqlite:///instance/payleo_dev.db (auto-created)
# PostgreSQL: paste the URL your host gives you as-is (postgres:// or postgresql://).
# The app switches it to the psycopg 3 driver automatically.
DATABASE_URL=

# CORS - comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# Business settings
DEFAULT_CURRENCY=USD
INVOICE_NUMBER_PREFIX=INV-
INVOICE_NUMBER_PADDING=6

# Pagination
PAGINATION_DEFAULT_PAGE_SIZE=20
PAGINATION_MAX_PAGE_SIZE=100
